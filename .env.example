NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side only (Docker): container → host Supabase URL
# When running via docker-compose, this is set automatically.
# For local dev without Docker, leave unset (falls back to NEXT_PUBLIC_SUPABASE_URL).
# SUPABASE_SERVER_URL=http://host.docker.internal:54321

NEXT_PUBLIC_SUPABASE_URL=http://localhost:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-supabase-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Required for a public production deployment.
LEGAL_OPERATOR_NAME=beanmap 개인정보 보호 담당자
LEGAL_CONTACT_EMAIL=privacy@beanmap.site

# Server-side only (Docker): container → host Supabase URL
# When running via docker-compose, this is set automatically.
# `npm run staging:up` sets this automatically for the Docker web process.
# SUPABASE_SERVER_URL=http://kong:8000

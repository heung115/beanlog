{
  "name": "coffe-info",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "node scripts/staging.mjs up",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "design:lint": "designmd lint DESIGN.md && node scripts/verify-design-tokens.mjs",
    "test": "npm run test:node && npm run test:go",
    "test:node": "node --test tests/*.test.mjs",
    "test:go": "cd server && GOTOOLCHAIN=go1.26.5 go test -race ./...",
    "vet:go": "cd server && GOTOOLCHAIN=go1.26.5 go vet ./...",
    "check": "node scripts/check.mjs",
    "check:fast": "node scripts/check.mjs --fast",
    "audit": "bash scripts/audit.sh",
    "audit:runtime": "bash scripts/audit.sh --runtime",
    "qa": "node scripts/staging.mjs qa",
    "qa:desktop": "node scripts/staging.mjs qa --project=desktop",
    "qa:security": "node scripts/staging.mjs qa tests/qa/security.spec.ts --project=desktop",
    "qa:seed": "node scripts/seed-unspecialty-test-account.mjs",
    "staging:up": "node scripts/staging.mjs up",
    "staging:qa": "node scripts/staging.mjs qa",
    "staging:status": "node scripts/staging.mjs status",
    "staging:logs": "node scripts/staging.mjs logs",
    "staging:down": "node scripts/staging.mjs down"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "clsx": "2.1.1",
    "next": "16.2.11",
    "next-intl": "4.13.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.10.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.12.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "serialize-javascript": "7.0.7"
  }
}

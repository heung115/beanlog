[Unit]
Description=Beanmap private console redacted status snapshot
After=docker.service

[Service]
Type=oneshot
User=root
Group=caddy
UMask=0027
ExecStart=/usr/bin/python3 /opt/beanmap-private-console/collector.py --config /etc/beanmap-console/collector.json
TimeoutStartSec=90
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/beanmap-console
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target

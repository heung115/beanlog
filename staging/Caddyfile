{
	admin off
	auto_https off
	persist_config off
	# No request/access logs: provenance proofs and authentication cookies stay
	# inside the proxy path. Container health reports readiness independently.
	log default {
		output discard
	}
}

:8080 {
	reverse_proxy web:3000 {
		header_up X-Beanmap-Client-IP {remote_host}
		header_up X-Beanmap-Client-Proof {$BEANMAP_AUTH_CLIENT_IP_SECRET}
		header_up -X-Beanmap-Auth-Client-IP
		header_up -X-Beanmap-Auth-Rate-Identity
	}
}
